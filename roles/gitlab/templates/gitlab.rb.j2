# =============================================================================
# GitLab Omnibus configuration
# =============================================================================
#
# Managed by Ansible.
#
# DO NOT edit this file manually.
#
# Source:
#   roles/gitlab/templates/gitlab.rb.j2
#
# Central configuration:
#   group_vars/gitlab.yml
#
# =============================================================================


# -----------------------------------------------------------------------------
# External URL
# -----------------------------------------------------------------------------

external_url '{{ gitlab_external_url }}'


# -----------------------------------------------------------------------------
# Let's Encrypt
# -----------------------------------------------------------------------------
#
# We use an Ansible-generated self-signed certificate instead of GitLab's
# Let's Encrypt integration.
#
# GitLab recommends explicitly disabling the Let's Encrypt integration when
# manually managing certificates.
# -----------------------------------------------------------------------------

letsencrypt['enable'] = false


# -----------------------------------------------------------------------------
# GitLab SSH
# -----------------------------------------------------------------------------

gitlab_rails['gitlab_shell_ssh_port'] = {{ gitlab_omnibus_ssh_port | int }}


# -----------------------------------------------------------------------------
# Bundled NGINX - HTTPS
# -----------------------------------------------------------------------------
#
# GitLab 19.2+ uses gitlab_rails['nginx'][*] for Rails-specific NGINX
# settings.
# -----------------------------------------------------------------------------

gitlab_rails['nginx']['enable'] = true

gitlab_rails['nginx']['listen_https'] = true

gitlab_rails['nginx']['listen_port'] = 443

gitlab_rails['nginx']['redirect_http_to_https'] = {{
  gitlab_redirect_http_to_https | bool | to_json
}}


# -----------------------------------------------------------------------------
# TLS certificate
# -----------------------------------------------------------------------------

gitlab_rails['nginx']['ssl_certificate'] = '{{ gitlab_tls_certificate_file }}'

gitlab_rails['nginx']['ssl_certificate_key'] = '{{ gitlab_tls_private_key_file }}'


# -----------------------------------------------------------------------------
# TLS protocols
# -----------------------------------------------------------------------------
#
# Keep protocol selection explicit.
# TLS 1.0/1.1 are not enabled.
# -----------------------------------------------------------------------------

gitlab_rails['nginx']['ssl_protocols'] = 'TLSv1.2 TLSv1.3'


# -----------------------------------------------------------------------------
# HSTS
# -----------------------------------------------------------------------------

gitlab_rails['nginx']['hsts_enabled'] = {{
  gitlab_hsts_enabled | bool | to_json
}}

gitlab_rails['nginx']['hsts_max_age'] = {{ gitlab_hsts_max_age | int }}

gitlab_rails['nginx']['hsts_include_subdomains'] = {{
  gitlab_hsts_include_subdomains | bool | to_json
}}

gitlab_rails['nginx']['hsts_preload'] = {{
  gitlab_hsts_preload | bool | to_json
}}


# -----------------------------------------------------------------------------
# Security-related NGINX behavior
# -----------------------------------------------------------------------------

# Hide NGINX version information from the HTTP response.
nginx['server_tokens'] = 'off'


# -----------------------------------------------------------------------------
# Optional services
# -----------------------------------------------------------------------------

# Container Registry remains disabled initially.
gitlab_rails['registry_enabled'] = {{
  gitlab_registry_enabled | bool | to_json
}}

# GitLab Pages remains disabled initially.
gitlab_pages['enable'] = {{
  gitlab_pages_enabled | bool | to_json
}}


# -----------------------------------------------------------------------------
# GitLab application logging
# -----------------------------------------------------------------------------

# Keep production logging enabled.
gitlab_rails['log_level'] = 'info'


# -----------------------------------------------------------------------------
# Prometheus
# -----------------------------------------------------------------------------
#
# GitLab Omnibus includes monitoring components. We keep the bundled
# monitoring stack enabled but do not expose its ports directly through Docker.
# -----------------------------------------------------------------------------

prometheus['enable'] = true


# -----------------------------------------------------------------------------
# GitLab NGINX access controls
# -----------------------------------------------------------------------------

# Do not accept arbitrary Host headers as the canonical GitLab hostname.
gitlab_rails['nginx']['proxy_set_headers'] = {
  "Host" => "$http_host",
  "X-Real-IP" => "$remote_addr",
  "X-Forwarded-For" => "$proxy_add_x_forwarded_for",
  "X-Forwarded-Proto" => "https",
  "X-Forwarded-Ssl" => "on"
}


# -----------------------------------------------------------------------------
# Disable unnecessary default functionality
# -----------------------------------------------------------------------------

# Do not enable GitLab Pages external URL configuration.
# No pages_external_url is defined because Pages is disabled.

# Do not enable Container Registry external URL configuration because the
# registry is disabled.


# -----------------------------------------------------------------------------
# Session security
# -----------------------------------------------------------------------------

# Secure cookies are appropriate because the instance is HTTPS-only.
gitlab_rails['session_store']['secure'] = true


# -----------------------------------------------------------------------------
# GitLab backups
# -----------------------------------------------------------------------------

gitlab_rails['backup_path'] = '{{ gitlab_backup_container_dir }}'
gitlab_rails['backup_keep_time'] = {{ gitlab_backup_retention_days | int }} * 86400


# -----------------------------------------------------------------------------
# Package configuration marker
# -----------------------------------------------------------------------------
#
# This comment makes it clear that all configuration is intentionally managed
# by Ansible.
#
# =============================================================================
# END OF ANSIBLE-MANAGED CONFIGURATION
# =============================================================================